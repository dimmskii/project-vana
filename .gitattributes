# Same bytes on every checkout (Windows included), so nothing shows as changed that wasn't.
# Text: stored with LF; checked out as LF everywhere (MTA reads either; the shell scripts need LF).
* text=auto eol=lf

# Game and image formats: never converted, never diffed as text.
*.txd binary
*.dff binary
*.ifp binary
*.col binary
*.img binary
*.mp3 binary
*.wav binary
*.png binary
*.jpg binary
*.dds binary
*.pdn binary
*.db binary

# Mods (docs/credits.md): kept exactly as their authors shipped them, CRLF text included.
vana-*/mods/** -text
