<meta>
    <info author="ProjectVana" name="Vana wildlife" description="Animals at their places in the countryside (Myths Maker 2.7's animal pack)" version="0.2.0" type="script" edf:definition="edf/vana-wildlife.edf" />
    <aclrequest>
        <right name="function.loadstring" access="true" /> <!-- importing shared code from vana-lib -->
    </aclrequest>
    <!-- The levers (docs/wildlife.md): change them with /vanaset wildlife <name> <value> or the admin panel. -->
    <settings>
        <setting name="@enabled" value="true" desc="Animals spawn at all" accept="true,false" />
        <setting name="@species" value="hare,deer,boar,cat,dog,wolf,brownbear,blackbear,puma,leopard" desc="Species that spawn (of those config/wildlife.lua knows), comma-separated" />
        <setting name="@density" value="1" desc="Scales each spawner's quantity" accept="0-10" />
        <setting name="@maxPerPlayer" value="12" desc="Animals within 200 m of a player, at most" accept="0-100" />
        <setting name="@maxTotal" value="60" desc="Animals on the server, at most" accept="0-500" />
        <setting name="@minSpawnDistance" value="30" desc="No animal appears closer than this to a player (m)" />
        <setting name="@despawnMargin" value="60" desc="Gone this far beyond its spawner's find radius from every player (m)" />
        <setting name="@aggroChance" value="0.5" desc="Chance a predator goes for a player it sees, each check (0-1)" accept="0-1" />
        <setting name="@aggroCheckMs" value="5000" desc="How often a predator may decide to attack (ms)" />
        <setting name="@aggroRange" value="25" desc="How far a predator sees a player (m)" />
        <setting name="@fleeRange" value="14" desc="Prey runs from a player this close (m)" />
        <setting name="@leash" value="60" desc="An animal walks back home from this far (m)" />
        <setting name="@damageScale" value="0.5" desc="Scales the pack's bite damage on players" accept="0-10" />
    </settings>
    <script src="lib.lua" type="shared" />
    <script src="config/species.lua" type="shared" />
    <script src="config/wildlife.lua" type="shared" />
    <script src="config/maps.lua" type="server" />
    <script src="server.lua" type="server" />
    <script src="client.lua" type="client" />
    <script src="help.lua" type="server" />
    <export function="getHelpPages" type="server" />
    <export function="getSettings" type="server" />
    <export function="setSetting" type="server" />
