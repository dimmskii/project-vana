<def name="vana-trains">
    <element name="tracknode" friendlyname="Track node">
        <data name="position" type="coord3d" default="0,0,0" />
        <data name="stop" type="selection:true,false" default="false" required="false" description="a station stop: trains that stop halt with their middle here" />
        <marker type="corona" size="0.8" color="#C08040A0" />
    </element>
    <element name="trackcrossing" friendlyname="Track crossing (a road or footpath over the rails)">
        <data name="position" type="coord3d" default="0,0,0" />
        <data name="track" type="integer" default="0" required="false" description="the track it crosses" />
        <data name="a" type="string" default="" required="false" description="the path link's one end (pathnode id)" />
        <data name="b" type="string" default="" required="false" description="its other end" />
        <data name="kind" type="string" default="vehicle" required="false" description="vehicle (a road) or ped (a footpath)" />
        <marker type="corona" size="1.5" color="#FF404090" />
    </element>
    <element name="platformspot" friendlyname="Platform spot (people wait for the train here)">
        <data name="position" type="coord3d" default="0,0,0" />
        <data name="rotation" type="coord3d" default="0,0,0" />
        <data name="stop" type="string" default="" required="false" description="the station stop it waits at (tracknode id)" />
        <marker type="corona" size="0.7" color="#40FF8090" />
    </element>
</def>
