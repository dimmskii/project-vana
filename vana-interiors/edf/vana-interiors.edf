<def name="vana-interiors">
    <element name="entrance" friendlyname="Entrance">
        <data name="position" type="coord3d" default="0,0,0" />
        <data name="name" type="string" default="" required="false" description="pairs with the same-named entry in another area" />
        <data name="size" type="string" default="2,2" required="false" description="trigger widths" />
        <data name="ex" type="number" default="0" required="false" description="exit point x (where you arrive coming through the paired entry)" />
        <data name="ey" type="number" default="0" required="false" description="exit point y" />
        <data name="ez" type="number" default="0" required="false" description="exit point z" />
        <data name="heading" type="number" default="0" required="false" description="facing at the exit point" />
        <data name="flags" type="integer" default="0" required="false" description="IPL enex flags (bit 4: a door leading to a shared hub)" />
        <data name="open" type="integer" default="0" required="false" description="opening hour" />
        <data name="close" type="integer" default="24" required="false" description="closing hour" />
        <data name="enabled" type="selection:true,false" default="true" required="false" description="usable at all" />
        <data name="instance" type="integer" default="0" required="false" description="dimension (0: the shared world; another: a copy of the interior of its own, e.g. a second 24/7)" />
        <marker type="arrow" size="1" color="#FFDC00AA" />
    </element>
    <script src="edf/edf_lines_client.lua" type="client" />
</def>
